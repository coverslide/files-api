    "@types/jest": "^29.5.12",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.2",
    "eslint-config-xo": "^0.49.0",
    "eslint-plugin-prettier": "^5.2.5",
    "jest": "^29.7.0",
    "prettier": "^3.5.2",
    "supertest": "^6.3.4"
  },
